{
  "manifest_version": 3,
  "name": "Linux Do Ultimate",
  "version": "0.5.0",
  "description": "Linux.do 分屏阅读、页内帖子标签、阅读计数修复、多标签链接预览与更新检查。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://linux.do/*"],
      "js": ["host.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://linux.do/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["preview-runtime.js"],
      "matches": ["https://linux.do/*"]
    }
  ]
}
