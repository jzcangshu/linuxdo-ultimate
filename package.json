{
  "name": "linuxdo-ultimate-browser-extension",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:extension": "tsx scripts/build-extension.ts",
    "build:all": "pnpm build && pnpm build:extension",
    "package:extension": "pnpm build:extension && tsx scripts/package-extension.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/tampermonkey": "^5.0.4",
    "esbuild": "^0.25.8",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0"
}
