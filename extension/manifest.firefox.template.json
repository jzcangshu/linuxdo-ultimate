{
  "manifest_version": 3,
  "name": "Linux Do Ultimate",
  "version": "__VERSION__",
  "description": "Linux.do 分屏阅读、页内帖子标签、阅读计数修复、错误弹窗自动过盾、链接预览与更新检查。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://linux.do/*"],
      "js": ["challenge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://linux.do/*"],
      "js": ["host.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://linux.do/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["preview-runtime.js", "frame-runtime.js", "topic-tools-runtime.js"],
      "matches": ["https://linux.do/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linuxdo-ultimate@jzcangshu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
